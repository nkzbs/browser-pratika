{
  "name": "pratika-browser",
  "version": "0.2.0",
  "description": "Browser PRATIKA con estensione IUV PagoPA integrata",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "pack": "electron-builder --dir"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "author": "nkzbs",
  "build": {
    "appId": "it.pratika.browser",
    "productName": "PRATIKA Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "modules/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PRATIKA-Browser-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  }
}
