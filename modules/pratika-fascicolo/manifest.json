{
  "manifest_version": 3,
  "name": "Fascicolo clienti e pratiche",
  "version": "0.1.0",
  "description": "Anagrafica clienti, pratiche auto con stato e avviso al cliente via WhatsApp.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "panel.html", "default_title": "Fascicolo clienti e pratiche", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "pratika_permissions": ["shared", "send:autofranciacorta"]
}
