{
  "manifest_version": 3,
  "name": "Registro pagamenti",
  "version": "0.1.0",
  "description": "Pagamenti PagoPA eseguiti, assegnati ai clienti, con esportazione per il commercialista e ricevuta al cliente.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "panel.html", "default_title": "Registro pagamenti", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "pratika_permissions": ["shared", "read:pratika-iuv", "send:autofranciacorta"]
}
