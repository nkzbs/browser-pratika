{
  "manifest_version": 3,
  "name": "Preventivo pratiche",
  "version": "0.1.0",
  "description": "Tariffario dello studio e preventivi per il cliente, con invio WhatsApp e creazione della pratica.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "panel.html", "default_title": "Preventivo pratiche", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "pratika_permissions": ["shared", "send:autofranciacorta"]
}
