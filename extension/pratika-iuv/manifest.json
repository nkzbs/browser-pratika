{
  "manifest_version": 3,
  "name": "PRATIKA – IUV PagoPA",
  "version": "2.2.6",
  "description": "Raccoglie gli IUV da Motorizzazione e PRA e li paga in sequenza dall'home banking Sella (CBILL).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "IUV PagoPA – apri pannello",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.ilportaledeltrasporto.it/*",
    "https://*.ilportaledeltrasporto.it/*",
    "http://esepra3.servizi2.aci/*",
    "http://*.servizi2.aci/*",
    "https://*.servizi2.aci/*",
    "https://www.sella.it/*",
    "https://sella.it/*",
    "https://*.sella.it/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ilportaledeltrasporto.it/*",
        "https://*.ilportaledeltrasporto.it/*",
        "http://esepra3.servizi2.aci/*",
        "http://*.servizi2.aci/*",
        "https://*.servizi2.aci/*"
      ],
      "js": [
        "extractor.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.sella.it/*",
        "https://sella.it/*",
        "https://*.sella.it/*"
      ],
      "js": [
        "bank.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}